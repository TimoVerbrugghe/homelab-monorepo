{
  "mcpServers": {
    "themarr": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=dotenv-cli@11.0.0",
        "dotenv",
        "-e",
        "./kubernetes/mediaplayback/themarr/themarr-secrets.env",
        "--",
        "npx",
        "--yes",
        "--package=mcp-remote@0.15.2",
        "mcp-remote",
        "https://themarr.kubernetes.timo.be/mcp",
        "--transport",
        "http-only",
        "--header",
        "X-Themarr-Api-Key:${API_KEY}"
      ],
      "tools": ["*"]
    },
    "subgen": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=dotenv-cli@11.0.0",
        "dotenv",
        "-e",
        "./kubernetes/mediaplayback/subgen/subgen-secrets.env",
        "--",
        "npx",
        "--yes",
        "--package=mcp-remote@0.15.2",
        "mcp-remote",
        "https://subgen.timo.be/mcp/",
        "--transport",
        "http-only",
        "--header",
        "X-API-Key:${AGENT_API_KEY}"
      ],
      "tools": ["*"]
    },
    "homeAssistant": {
      "type": "http",
      "url": "http://10.10.10.28:8123/api/webhook/mcp_100d2242e491e35d6076635a52461fa3",
      "tools": [
        "*"
      ]
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "tools": [
        "*"
      ]
    },
    "kubernetes": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "mcp-server-kubernetes"
      ],
      "tools": [
        "*"
      ]
    },
    "shelly-api-docs": {
      "type": "http",
      "url": "https://shelly-api-docs.mcp.shelly.link/mcp",
      "tools": [
        "*"
      ]
    },
    "siderolabs-docs": {
      "type": "http",
      "url": "https://docs.siderolabs.com/mcp",
      "tools": [
        "*"
      ]
    },
    "unifi-network": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=dotenv-cli@11.0.0",
        "dotenv",
        "-e",
        "./mcp-secrets.env",
        "--",
        "uvx",
        "--with",
        "unifi-mcp-shared==0.6.7",
        "unifi-network-mcp==0.29.3"
      ],
      "env": {
        "UNIFI_HOST": "unifi.local.timo.be",
        "UNIFI_USERNAME": "unifimcp",
        "UNIFI_VERIFY_SSL": "true"
      },
      "tools": [
        "*"
      ]
    },
    "portainer": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=dotenv-cli@11.0.0",
        "dotenv",
        "-e",
        "./mcp-secrets.env",
        "--",
        "uvx",
        "mcp-portainer"
      ],
      "env": {
        "PORTAINER_URL": "https://portainer.kubernetes.timo.be"
      },
      "tools": [
        "*"
      ]
    },
    "proxmox": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=dotenv-cli@11.0.0",
        "dotenv",
        "-e",
        "./mcp-secrets.env",
        "--",
        "uvx",
        "proxmox-mcp-plus"
      ],
      "env": {
        "PROXMOX_HOST": "proxmox.kubernetes.timo.be",
        "PROXMOX_PORT": "443",
        "PROXMOX_TOKEN_NAME": "mcp-token",
        "PROXMOX_USER": "root@pam",
        "PROXMOX_VERIFY_SSL": "true"
      },
      "tools": [
        "*"
      ]
    },
    "truenas": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=dotenv-cli@11.0.0",
        "dotenv",
        "-e",
        "./mcp-secrets.env",
        "--",
        "truenas-mcp"
      ],
      "env": {
        "TRUENAS_URL": "wss://truenas.local.timo.be/api/current"
      },
      "tools": ["*"]
    },
    "tailscale": {
      "command": "npx",
      "args": [
        "--yes",
        "--package=dotenv-cli@11.0.0",
        "dotenv",
        "-e",
        "./mcp-secrets.env",
        "--",
        "npx",
        "--yes",
        "--package=@hexsleeves/tailscale-mcp-server",
        "tailscale-mcp-server"
      ],
      "env": {
        "TAILSCALE_TAILNET": "pony-godzilla.ts.net"
      },
      "tools": [
        "*"
      ]
    }
  }
}
