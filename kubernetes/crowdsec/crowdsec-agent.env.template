# Static, self-generated machine credentials (e.g. `openssl rand -hex 16` for the
# password; the username just needs to be unique/stable). LAPI self-registers this
# machine with these exact values on every start via AGENT_USERNAME/AGENT_PASSWORD in
# crowdsec-values.yaml, and the agent DaemonSet writes the same values into its
# local_api_credentials.yaml instead of generating a random identity -- do not use
# `cscli machines add`-issued credentials here.
agent-username=
agent-password=
