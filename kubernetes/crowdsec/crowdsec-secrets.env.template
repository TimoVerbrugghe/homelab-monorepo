# Static, self-generated key (e.g. `openssl rand -hex 32`). LAPI self-registers the
# traefik_bouncer with this exact value on every start via BOUNCER_KEY_traefik_bouncer
# in crowdsec-values.yaml -- do not use a cscli-issued key here.
bouncer-api-key=

# Static, self-generated machine credentials (`openssl rand -hex 16` for the
# password; username just needs to be unique/stable) -- not `cscli`-issued.
# LAPI and the agent DaemonSet both use these exact values (crowdsec-values.yaml).
agent-username=
agent-password=

# Enrollment key from https://app.crowdsec.net/security-engines -> "Enroll
# command" -> "Kubernetes" tab (same value for every instance you enroll).
# Optional -- leave blank to skip console enrollment
enroll-key=
