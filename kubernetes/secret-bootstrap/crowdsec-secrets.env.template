# Static machine credentials shared by LAPI and the agent DaemonSet.
# Generate the password with `openssl rand -hex 16`; use a stable, unique username.
agent-password=
agent-username=

# Self-generated key (for example `openssl rand -hex 32`), not a cscli-issued key.
# LAPI registers traefik_bouncer with this value on every start.
bouncer-api-key=

# Optional enrollment key from the Kubernetes tab at app.crowdsec.net.
enroll-key=
