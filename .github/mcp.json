// This file is a copy-paste source for the GitHub Copilot cloud coding agent's
// repository-level MCP configuration (repo Settings > Copilot > MCP servers).
//
// How this differs from .mcp.json:
// - .mcp.json is the portable workspace-level MCP configuration read by the
//   Copilot Agent Host. Local stdio servers load mcp-secrets.env via dotenv-cli.
// - This file runs MCP servers inside GitHub's cloud agent sandbox. Secret references
//   use "COPILOT_MCP_*" Agents secrets/variables (configured separately under
//   Settings > Copilot > Coding agent > Secrets and variables)
// - Network access to homelab services (Kubernetes API, Home Assistant, etc.)
//   is only possible because .github/workflows/copilot-setup-steps.yaml joins
//   the tailnet (tailscale/github-action) and writes a kubeconfig before the
//   agent's tools are started, with "accept-routes: true" so LAN-advertised
//   subnet routes (e.g. 10.10.10.0/24) are reachable too.
// - "unifi-network" and "proxmox" use "uvx" from Python's "uv" toolchain,
//   which is installed by copilot-setup-steps.yaml.
//
// Required Agents secrets (repo Settings > Copilot > Coding agent > Secrets
// and variables > New secret) -- names MUST start with "COPILOT_MCP_":
//   COPILOT_MCP_HA_TOKEN                       Home Assistant long-lived access token
//   COPILOT_MCP_PORTAINER_TOKEN                 Portainer administrator API token
//   COPILOT_MCP_UNIFI_PASSWORD                  UniFi local admin password
//   COPILOT_MCP_PROXMOX_TOKEN_VALUE             Proxmox API token value
//   COPILOT_MCP_TRUENAS_API_KEY                 Least-privilege TrueNAS API key
//   COPILOT_MCP_TRUENAS_API_USER                TrueNAS username that owns the API key
//   COPILOT_MCP_TAILSCALE_OAUTH_CLIENT_ID        Tailscale OAuth client ID for the MCP server's own tailnet API access (separate from the Actions-level TAILSCALE_OAUTH_CLIENT_ID secret used by copilot-setup-steps.yaml to join the tailnet)
//   COPILOT_MCP_TAILSCALE_OAUTH_CLIENT_SECRET    Tailscale OAuth client secret (see above)
{
  "mcpServers": {
    "homeAssistant": {
      "type": "http",
      "url": "http://homeassistant.pony-godzilla.ts.net:8123/api/webhook/mcp_100d2242e491e35d6076635a52461fa3",
      "tools": ["*"],
      "headers": {
        "Authorization": "Bearer $COPILOT_MCP_HA_TOKEN"
      }
    },
    "kubernetes": {
      "type": "local",
      "command": "npx",
      "args": ["mcp-server-kubernetes"],
      "tools": ["*"]
    },
    "siderolabs-docs": {
      "type": "http",
      "url": "https://docs.siderolabs.com/mcp",
      "tools": ["*"]
    },
    "portainer": {
      "type": "local",
      "command": "uvx",
      "args": ["mcp-portainer"],
      "tools": ["*"],
      "env": {
        "PORTAINER_URL": "https://portainer.pony-godzilla.ts.net",
        "PORTAINER_API_KEY": "$COPILOT_MCP_PORTAINER_TOKEN"
      }
    },
    "unifi-network": {
      "type": "local",
      "command": "uvx",
      "args": ["unifi-network-mcp@latest"],
      "tools": ["*"],
      "env": {
        "UNIFI_HOST": "10.10.10.1",
        "UNIFI_USERNAME": "unifimcp",
        "UNIFI_PASSWORD": "$COPILOT_MCP_UNIFI_PASSWORD",
        "UNIFI_VERIFY_SSL": "false"
      }
    },
    "proxmox": {
      "type": "local",
      "command": "uvx",
      "args": ["proxmox-mcp-plus"],
      "tools": ["*"],
      "env": {
        "PROXMOX_HOST": "proxmox.pony-godzilla.ts.net",
        "PROXMOX_USER": "root@pam",
        "PROXMOX_TOKEN_NAME": "mcp-token-github",
        "PROXMOX_TOKEN_VALUE": "$COPILOT_MCP_PROXMOX_TOKEN_VALUE",
        "PROXMOX_PORT": "443",
        "PROXMOX_VERIFY_SSL": "true"
      }
    },
    "truenas": {
      "type": "local",
      "command": "/usr/local/bin/truenas-mcp",
      "args": [],
      "tools": ["*"],
      "env": {
        "TRUENAS_API_KEY": "$COPILOT_MCP_TRUENAS_API_KEY",
        "TRUENAS_API_USER": "$COPILOT_MCP_TRUENAS_API_USER",
        "TRUENAS_INSECURE": "1",
        "TRUENAS_URL": "wss://thefactory.pony-godzilla.ts.net:443/websocket"
      }
    },
    "cloudflare": {
      "type": "http",
      "url": "https://mcp.cloudflare.com/mcp",
      "tools": ["*"]
    },
    "shelly-api-docs": {
      "type": "http",
      "url": "https://shelly-api-docs.mcp.shelly.link/mcp",
      "tools": ["*"]
    }
  }
}
